{
  "name": "qw-pages-static-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/build-output.test.mjs && node tools/check-assets.mjs",
    "sync": "node scripts/sync-umkm.mjs --resize 1400",
    "sync:check": "node scripts/sync-umkm.mjs --dry-run",
    "check:assets": "npm run build --silent && node tools/check-assets.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "electron-to-chromium": "1.5.395"
  }
}
